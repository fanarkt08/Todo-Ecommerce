# Modèle du .env d'un environnement sur le serveur (production ou préproduction).
# À placer à la racine du clone : ~/Todo-Ecommerce/.env (prod) ou ~/Todo-Ecommerce-preprod/.env (préprod).
# Jamais commité, droits restreints (chmod 600). Utiliser des secrets DIFFÉRENTS pour chaque environnement.

NODE_ENV=production
PORT=5000

# Secret de signature des tokens JWT (32 caractères minimum). Générer avec : openssl rand -hex 64
JWT_SECRET=

# Compte administrateur MongoDB, créé au premier démarrage du conteneur (base vide)
MONGO_USER=todo_admin
# Générer avec : openssl rand -hex 24 (hexadécimal : aucun caractère à échapper dans l'URI)
MONGO_PASSWORD=
# Reprendre ici le même utilisateur et le même mot de passe
MONGO_URI=mongodb://todo_admin:<MONGO_PASSWORD>@mongo:27017/exam_practice_db?authSource=admin

# prod ou preprod : nom sous lequel Caddy joint le frontend (prod-frontend / preprod-frontend)
APP_ENV=prod
# Active la configuration serveur (aucun port publié, réseau partagé avec Caddy)
COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
