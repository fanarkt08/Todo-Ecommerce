# Modèle de configuration locale du backend.
# Copier en backend/.env (jamais commité) : cp backend/.env.example backend/.env

# URI de la base MongoDB locale.
# Avec Docker en local, docker-compose.yml la remplace par mongodb://mongo:27017/exam_practice_db
MONGO_URI=mongodb://localhost:27017/exam_practice_db

# Secret de signature des tokens JWT : 32 caractères minimum, sinon le serveur refuse de démarrer.
# Générer avec : openssl rand -hex 64
JWT_SECRET=

# Facultatif
# PORT=5000
# Niveau de logs : debug, info, warn ou error
# LOG_LEVEL=info
# Sites autorisés à appeler l'API depuis un navigateur (séparés par des virgules), aucun par défaut
# CORS_ORIGINS=
