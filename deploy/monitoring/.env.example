# Modèle du fichier deploy/monitoring/.env (à créer sur le serveur, jamais commité).

# Mot de passe du compte "admin" de Grafana
GRAFANA_ADMIN_PASSWORD=

# Envoi des alertes par email (exemple : Gmail avec un mot de passe d'application)
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=adresse.expediteur@gmail.com
SMTP_USER=adresse.expediteur@gmail.com
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true

# Destinataire des alertes
ALERT_EMAIL_TO=adresse.destinataire@example.com
